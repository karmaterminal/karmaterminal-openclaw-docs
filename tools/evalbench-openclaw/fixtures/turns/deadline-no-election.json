{
  "id": "deadline-no-election",
  "describe": "A turn still running at the deadline, polling in exec; it elected nothing.",
  "rows": [
    {
      "role": "assistant",
      "provider": "{{provider}}",
      "model": "{{model}}",
      "content": [
        {
          "type": "toolCall",
          "id": "e1",
          "name": "exec",
          "arguments": {
            "command": "sleep 900; ls /tmp/evalprop"
          }
        }
      ],
      "usage": {
        "input": 1200,
        "output": 40,
        "cacheRead": 24000,
        "cacheWrite": 0,
        "totalTokens": 25240
      },
      "__openclaw": {
        "runId": "{{runId}}"
      }
    }
  ],
  "wait": {
    "status": "never"
  },
  "afterAbort": [
    {
      "role": "toolResult",
      "toolCallId": "e1",
      "toolName": "exec",
      "isError": true,
      "content": [
        {
          "type": "text",
          "text": "aborted"
        }
      ],
      "__openclaw": {
        "runId": "{{runId}}"
      }
    }
  ]
}
