{
  "id": "runaway-fan-out",
  "describe": "A turn that starts six collectors, one in each of six swarm groups of its own naming. The product admits the first collector of every group, so all six run; none has finished a call yet.",
  "rows": [
    {
      "role": "assistant",
      "provider": "{{provider}}",
      "model": "{{model}}",
      "content": [
        {
          "type": "toolCall",
          "id": "e1",
          "name": "exec",
          "arguments": {
            "command": "sleep 900; ls /tmp/evalprop"
          }
        }
      ],
      "usage": {
        "input": 1200,
        "output": 40,
        "cacheRead": 24000,
        "cacheWrite": 0,
        "totalTokens": 25240
      },
      "__openclaw": {
        "runId": "{{runId}}"
      }
    }
  ],
  "wait": {
    "status": "never"
  },
  "runaway": {
    "groups": 6,
    "child": {
      "callTokens": 60000,
      "callSeconds": 60
    },
    "ignores": [
      "abort",
      "delete"
    ]
  }
}
