{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "title": "k6 PROOFS metrics contract",
      "url": "../METRICS.md",
      "type": "link"
    }
  ],
  "panels": [
    {
      "title": "Provenance outcomes (all samples)",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum by (outcome) (openclaw_proofs_k6_run_total{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\"})",
          "legendFormat": "{{outcome}}"
        }
      ],
      "description": "Provenance view: counts all candidate proof samples, including red/partial history. Not a latest verdict."
    },
    {
      "title": "Pending human review",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(openclaw_proofs_k6_candidate_pending_review{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\", fold_requires_review=\"true\"})",
          "legendFormat": "pending review"
        }
      ],
      "description": "Fold-readiness queue: visual green means ready for human review, not canonical PROOFS fold."
    },
    {
      "title": "Proof failures",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(openclaw_proofs_k6_proof_failures_total{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\"})",
          "legendFormat": "proof failures"
        }
      ],
      "description": "Total proof_failures emitted by selected candidate runs."
    },
    {
      "title": "Average checks rate",
      "type": "gauge",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "avg(openclaw_proofs_k6_checks_rate{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\"})",
          "legendFormat": "checks rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      },
      "description": "Average k6 checks.rate for selected candidate rows."
    },
    {
      "title": "Outcomes per seat",
      "type": "barchart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "sum by (seat, outcome) (openclaw_proofs_k6_run_total{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\"})",
          "legendFormat": "{{seat}} {{outcome}}"
        }
      ],
      "description": "Outcome distribution by seat."
    },
    {
      "title": "Current candidate by row / seat / run",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "topk by (row_id, seat, candidate_sha) (1, max by (row_id, seat, candidate_sha, run_id, outcome, failure_class, fold_requires_review) (timestamp(openclaw_proofs_k6_run_total{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\"})))",
          "legendFormat": "{{row_id}} {{seat}} {{run_id}} {{outcome}}"
        }
      ],
      "description": "Current-candidate view: latest run sample per row/seat/SHA, preserving outcome/failure labels."
    },
    {
      "title": "Duration by row",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "avg by (row_id, seat) (openclaw_proofs_k6_duration_ms{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\"})",
          "legendFormat": "{{row_id}} {{seat}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "description": "Average normalized row duration in milliseconds."
    },
    {
      "title": "Missing required receipts",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "openclaw_proofs_k6_receipt_status{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\", receipt_required=\"true\", receipt_status!=\"present\"}",
          "legendFormat": "{{row_id}} {{seat}} {{receipt_name}}"
        }
      ],
      "description": "Required receipts that are missing or unknown."
    },
    {
      "title": "Failure classes",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (failure_class) (openclaw_proofs_k6_run_total{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\"})",
          "legendFormat": "{{failure_class}}"
        }
      ],
      "description": "Coarse failure-class breakdown."
    },
    {
      "title": "Recent run volume",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "sum by (outcome) (increase(openclaw_proofs_k6_run_total{candidate_sha=~\"$candidate_sha\", row_id=~\"$row_id\", seat=~\"$seat\"}[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ],
      "description": "Recent provenance volume by outcome. Historical red/partial samples are useful audit history, not necessarily current state."
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "k6",
    "proofs",
    "continuation",
    "project-81"
  ],
  "templating": {
    "list": [
      {
        "name": "candidate_sha",
        "type": "query",
        "label": "candidate_sha",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(openclaw_proofs_k6_run_total, candidate_sha)",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "row_id",
        "type": "query",
        "label": "row_id",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(openclaw_proofs_k6_run_total, row_id)",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "seat",
        "type": "query",
        "label": "seat",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(openclaw_proofs_k6_run_total, seat)",
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": false,
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "k6 PROOFS — Candidate Row Health",
  "uid": "k6-proofs-candidate-row-health",
  "version": 2
}
