{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karmaterminal/karmaterminal-openclaw-docs/tools/k6-proofs/row-manifest.schema.json",
  "title": "OpenClaw k6 PROOFS row manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rowId",
    "candidateSha",
    "seat",
    "sessionKey",
    "transport",
    "toolSurface",
    "mutates",
    "timeoutSeconds",
    "expectedReceipts",
    "artifactDestination",
    "review"
  ],
  "properties": {
    "schema": { "const": "openclaw.k6.proof-row-manifest.v1" },
    "rowId": { "type": "string", "minLength": 1 },
    "issue": { "type": "integer", "minimum": 1 },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "seat": { "type": "string", "minLength": 1 },
    "sessionKey": { "type": "string", "minLength": 1 },
    "transport": { "enum": ["websocket", "http-tools-invoke", "offline"] },
    "toolSurface": { "enum": ["typed-tool", "token", "bracket-token", "read-only", "mixed"] },
    "mutates": { "type": "boolean" },
    "timeoutSeconds": { "type": "integer", "minimum": 1 },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wsEnv": { "type": "string", "default": "OPENCLAW_GATEWAY_WS" },
        "tokenEnv": { "type": "string", "default": "OPENCLAW_GATEWAY_TOKEN" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "enum": ["runnable", "scaffold", "construct-only"],
          "description": "Runnable means scenario.file/name resolves to tools/k6-proofs/scenarios/*.js. Scaffold/construct-only rows are intentional non-runnable manifest entries."
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.js$",
          "description": "Runnable scenario file basename under tools/k6-proofs/scenarios/."
        },
        "expectedFile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.js$",
          "description": "Planned scenario file basename for scaffold rows. The file is not expected to exist yet."
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "methods": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "registryNotes": { "type": "string" }
      }
    },
    "expectedReceipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "pathHint": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "artifactDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "sha", "row", "seat", "runDirPrefix"],
      "properties": {
        "root": { "type": "string", "default": "PROOFS" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "row": { "type": "string", "minLength": 1 },
        "seat": { "type": "string", "minLength": 1 },
        "runDirPrefix": { "type": "string", "default": "k6-run" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateOnly", "foldRequiresReview"],
      "properties": {
        "candidateOnly": { "type": "boolean", "const": true },
        "foldRequiresReview": { "type": "boolean", "const": true },
        "notes": { "type": "string" }
      }
    },
    "liveRun": {
      "type": "object",
      "additionalProperties": false,
      "description": "Live-run safety contract (#146). All fields optional; check-live-run-safety.mjs infers defaults when absent.",
      "properties": {
        "requiresLiveGatewayToken": {
          "type": "boolean",
          "description": "Row needs OPENCLAW_GATEWAY_TOKEN in env to fire. Default: true for runnable rows, false for offline/construct-only."
        },
        "requiresTargetSessionKey": {
          "type": "boolean",
          "description": "Row needs a real target session key (not a placeholder). Default: true for live rows."
        },
        "requiresOutsideK6Orchestration": {
          "type": "boolean",
          "description": "Row needs an agent / prince to emit the trigger; k6 alone cannot drive the proof. Default: false for typed-tool rows, true for bracket-token / model-byte / detached-intermediate rows."
        },
        "safeToRunConcurrently": {
          "type": "boolean",
          "description": "Safe to run alongside other live continuation rows on the same session. Default: false for live rows."
        },
        "expectedArtifactClass": {
          "enum": [
            "PASS-candidate",
            "PARTIAL-candidate",
            "HONEST-LIMIT-candidate",
            "FAIL-candidate",
            "construct-only"
          ],
          "description": "Outcome the manifest declares before the run. Folding to PASS requires the candidate to match this class."
        },
        "notes": { "type": "string" }
      }
    }
  }
}
