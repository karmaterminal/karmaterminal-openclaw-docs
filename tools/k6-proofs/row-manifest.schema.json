{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karmaterminal/karmaterminal-openclaw-docs/tools/k6-proofs/row-manifest.schema.json",
  "title": "OpenClaw k6 PROOFS row manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rowId",
    "candidateSha",
    "seat",
    "sessionKey",
    "transport",
    "toolSurface",
    "mutates",
    "timeoutSeconds",
    "expectedReceipts",
    "artifactDestination",
    "review"
  ],
  "properties": {
    "schema": { "const": "openclaw.k6.proof-row-manifest.v1" },
    "rowId": { "type": "string", "minLength": 1 },
    "issue": { "type": "integer", "minimum": 1 },
    "candidateSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "seat": { "type": "string", "minLength": 1 },
    "sessionKey": { "type": "string", "minLength": 1 },
    "transport": { "enum": ["websocket", "http-tools-invoke", "offline"] },
    "toolSurface": { "enum": ["typed-tool", "token", "bracket-token", "read-only", "mixed"] },
    "mutates": { "type": "boolean" },
    "timeoutSeconds": { "type": "integer", "minimum": 1 },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wsEnv": { "type": "string", "default": "OPENCLAW_GATEWAY_WS" },
        "tokenEnv": { "type": "string", "default": "OPENCLAW_GATEWAY_TOKEN" }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "status": {
          "enum": ["runnable", "scaffold", "construct-only"],
          "description": "Runnable means scenario.file/name resolves to tools/k6-proofs/scenarios/*.js. Scaffold/construct-only rows are intentional non-runnable manifest entries."
        },
        "file": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.js$",
          "description": "Runnable scenario file basename under tools/k6-proofs/scenarios/."
        },
        "expectedFile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+\\.js$",
          "description": "Planned scenario file basename for scaffold rows. The file is not expected to exist yet."
        },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "methods": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "registryNotes": { "type": "string" }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": true,
      "description": "Row-specific fire parameters consumed by the scenario (tool, forms, delay, prompt template, idempotency prefix)."
    },
    "seatClassExpectation": {
      "type": "object",
      "additionalProperties": true,
      "description": "Per-seat-class expected artifact classes for rows whose provable ceiling depends on the seat's final-text surface."
    },
    "sourceContract": {
      "type": "object",
      "additionalProperties": true,
      "description": "Exact-SHA source-contract binding for rows proven against committed product source rather than a live gateway."
    },
    "telemetryContract": {
      "type": "object",
      "additionalProperties": false,
      "description": "Telemetry rebind contract (karmaterminal/openclaw#1254). Declares the product spans/attributes a row's claim rests on, whether the product emits them today, and what a later independent observer needs to re-derive the same slice. A row may only claim a telemetry-rebindable PASS when every identity and proof-run marker is declared emitted by the product.",
      "required": [
        "schema",
        "census",
        "enforcement",
        "rebindable",
        "productInstrumentationPrerequisite",
        "expectedTelemetry",
        "redaction",
        "controls",
        "backendUnavailable",
        "artifact",
        "verdictAuthority",
        "execution"
      ],
      "properties": {
        "schema": { "const": "openclaw.k6.row-telemetry-contract.v1" },
        "remedyConcern": {
          "enum": [
            "origin-provenance",
            "proof-run-classification",
            "terminal-outcome",
            "backend-disposition"
          ],
          "description": "Set only on the cross-cutting remedy rows. Each concern is owned by exactly one row so the split cannot silently lose a census finding."
        },
        "census": {
          "type": "object",
          "additionalProperties": false,
          "required": ["issue", "reportCommit", "productBasis"],
          "properties": {
            "issue": { "type": "string", "minLength": 1 },
            "reportCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "productBasis": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "limits": { "type": "string" }
          }
        },
        "enforcement": {
          "enum": ["advisory", "blocking"],
          "description": "advisory records unproven rebind receipts in row-result.json without changing the row's behavioral verdict. blocking caps the row below PASS-candidate until every rebindReceipt is explicitly present."
        },
        "rebindable": {
          "type": "boolean",
          "description": "True only when an independent observer could re-derive this row's claim from committed telemetry alone."
        },
        "productInstrumentationPrerequisite": {
          "type": "boolean",
          "description": "True when the contract cannot be satisfied until OpenClaw emits the declared attributes/spans."
        },
        "prerequisiteRows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Remedy rows that must land before this row can become rebindable."
        },
        "rebindReceipts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "Receipt names that must be explicitly present before a telemetry-rebindable claim is allowed."
        },
        "expectedTelemetry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spans", "attributes"],
          "properties": {
            "spans": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "role", "emittedByProduct"],
                "properties": {
                  "name": { "type": "string", "minLength": 1 },
                  "role": {
                    "enum": [
                      "accepted-entry",
                      "fire",
                      "wake",
                      "return",
                      "terminal-outcome",
                      "tool-execution",
                      "queue",
                      "compaction",
                      "proof-marker-carrier",
                      "backend-status"
                    ]
                  },
                  "emittedByProduct": { "type": "boolean" },
                  "productIssue": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            },
            "attributes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["key", "purpose", "emittedByProduct", "publicSafeForm"],
                "properties": {
                  "key": { "type": "string", "minLength": 1 },
                  "purpose": {
                    "enum": [
                      "origin",
                      "session",
                      "turn",
                      "run",
                      "proof-run",
                      "terminal-outcome",
                      "chain",
                      "reason",
                      "backend-completeness",
                      "other"
                    ]
                  },
                  "emittedByProduct": { "type": "boolean" },
                  "publicSafeForm": {
                    "enum": [
                      "enum",
                      "salted-fingerprint",
                      "sha256-16",
                      "literal-sha",
                      "integer",
                      "boolean",
                      "duration-ms"
                    ]
                  },
                  "productIssue": { "type": "string" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "redaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "forbiddenInArtifacts"],
          "properties": {
            "rule": { "type": "string", "minLength": 1 },
            "forbiddenInArtifacts": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "saltSource": { "type": "string" }
          }
        },
        "controls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["positive", "negative"],
          "properties": {
            "positive": { "type": "string", "minLength": 1 },
            "negative": { "type": "string", "minLength": 1 },
            "notes": { "type": "string" }
          }
        },
        "backendUnavailable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["disposition", "treatZeroAsAbsence", "requiredCompletenessKeys", "rebindKeys"],
          "properties": {
            "disposition": { "enum": ["PARTIAL-candidate", "FAIL-candidate"] },
            "treatZeroAsAbsence": {
              "const": false,
              "description": "A degraded backend that answers 200 with zero results is never evidence of absence."
            },
            "requiredCompletenessKeys": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "rebindKeys": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "notes": { "type": "string" }
          }
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "requiredFiles"],
          "properties": {
            "schema": { "type": "string", "minLength": 1 },
            "requiredFiles": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "notes": { "type": "string" }
          }
        },
        "verdictAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["passScope", "pass", "partial", "fail"],
          "properties": {
            "passScope": {
              "enum": [
                "behavioral-only",
                "behavioral-and-telemetry-rebindable",
                "backend-disposition-contract"
              ]
            },
            "backendDispositionContract": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requiredBackends",
                "rowPassStatuses",
                "requireNonAuthoritativeZero",
                "requireCompleteRebind"
              ],
              "properties": {
                "requiredBackends": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "enum": ["tempo", "loki"] }
                },
                "rowPassStatuses": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": ["complete", "partial", "unavailable", "capped", "unknown"]
                  }
                },
                "requireNonAuthoritativeZero": { "const": true },
                "requireCompleteRebind": { "const": true }
              },
              "description": "Two-level verdict policy used only by R-OBS-BACKEND-DISPOSITION. It may accept an honest degraded status as a row-contract PASS without changing backend health or count authority."
            },
            "pass": { "type": "string", "minLength": 1 },
            "partial": { "type": "string", "minLength": 1 },
            "fail": { "type": "string", "minLength": 1 },
            "honestLimit": { "type": "string" }
          }
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deterministicK6", "manual", "relationship"],
          "properties": {
            "deterministicK6": { "type": "string", "minLength": 1 },
            "manual": { "type": "string", "minLength": 1 },
            "relationship": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "liveRunSafety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "requiresLiveGatewayToken",
        "requiresTargetSessionKey",
        "requiresCandidateSha",
        "requiresExternalAgentOrToolInvocation",
        "sameSessionConcurrencySafe",
        "expectedArtifactClass",
        "requiredReceipts",
        "foldRequiresReview"
      ],
      "properties": {
        "classification": {
          "enum": ["static-preflight-only", "k6-runnable", "orchestration-required", "construct-only"],
          "description": "Static/preflight-only rows never fire the live gateway; k6-runnable rows may be started by run-proof.sh; orchestration-required rows need an external agent/tool/human step and are rejected by the live-run guard; construct-only rows document planned/non-runnable proof contracts and are also rejected by the live-run guard."
        },
        "requiresLiveGatewayToken": { "type": "boolean" },
        "requiresTargetSessionKey": { "type": "boolean" },
        "requiresCandidateSha": {
          "type": "boolean",
          "description": "True when OPENCLAW_CANDIDATE_SHA must be present and a 40-character hex SHA before the row can run."
        },
        "requiresExternalAgentOrToolInvocation": {
          "type": "boolean",
          "description": "True when k6 REST/WS alone is not enough and an agent/tool invocation outside the raw k6 transport is required."
        },
        "requiresHumanConfirmation": {
          "type": "boolean",
          "description": "True when a human must confirm the row before or during the fire."
        },
        "requiresDisposableSession": {
          "type": "boolean",
          "description": "True when the row must run against a disposable session rather than a long-lived seat session."
        },
        "sameSessionConcurrencySafe": {
          "type": "boolean",
          "description": "False means do not run this row concurrently against the same target session unless the row explicitly proves concurrency behavior."
        },
        "expectedArtifactClass": {
          "enum": ["PASS-candidate", "HONEST-LIMIT-candidate", "PARTIAL-candidate", "FAIL-candidate", "construct-only"],
          "description": "The highest artifact class this run should emit before maintainer review/fold."
        },
        "requiredReceipts": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "foldRequiresReview": { "type": "boolean", "const": true },
        "notes": { "type": "string" }
      }
    },
    "expectedReceipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "required"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "pathHint": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "artifactDestination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "sha", "row", "seat", "runDirPrefix"],
      "properties": {
        "root": { "type": "string", "default": "PROOFS" },
        "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "row": { "type": "string", "minLength": 1 },
        "seat": { "type": "string", "minLength": 1 },
        "runDirPrefix": { "type": "string", "default": "k6-run" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateOnly", "foldRequiresReview"],
      "properties": {
        "candidateOnly": { "type": "boolean", "const": true },
        "foldRequiresReview": { "type": "boolean", "const": true },
        "notes": { "type": "string" }
      }
    }
  }
}
