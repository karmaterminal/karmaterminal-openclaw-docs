{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/karmaterminal/karmaterminal-openclaw-docs/tools/k6-proofs/seat-readiness.schema.json",
  "title": "OpenClaw k6 PROOFS target readiness receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generatedAt",
    "outcome",
    "policy",
    "expectedK6Version",
    "k6",
    "gateway",
    "target",
    "bindings",
    "candidate",
    "seat",
    "session",
    "env",
    "concurrency",
    "notes",
    "bindingDigest",
    "integrity"
  ],
  "properties": {
    "schema": { "const": "openclaw.k6.seat-readiness.v2" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "outcome": { "enum": ["PASS-candidate", "PARTIAL-candidate"] },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "source": { "type": "string" }
      }
    },
    "expectedK6Version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "k6": { "type": "object" },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "healthReachable"],
      "properties": {
        "mode": { "enum": ["authenticated-rpc", "skipped-by-flag"] },
        "healthReachable": { "type": "boolean" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gatewayUrlFingerprint",
        "configuredMaxSpawnDepth",
        "effectiveMaxSpawnDepth",
        "requiredMaxSpawnDepth",
        "expectedMaxSpawnDepth",
        "continuation",
        "authentication"
      ],
      "properties": {
        "gatewayUrlFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "configuredMaxSpawnDepth": { "type": ["integer", "null"], "minimum": 1 },
        "effectiveMaxSpawnDepth": { "type": ["integer", "null"], "minimum": 1 },
        "requiredMaxSpawnDepth": { "type": ["integer", "null"], "minimum": 1 },
        "expectedMaxSpawnDepth": { "type": ["integer", "null"], "minimum": 1 },
        "continuation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configured", "effective"],
          "properties": {
            "configured": { "type": "object" },
            "effective": { "type": "object" }
          }
        },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "authenticated", "request", "response"],
          "properties": {
            "scheme": { "const": "gateway-token" },
            "authenticated": { "type": "boolean" },
            "request": { "type": ["object", "null"] },
            "response": { "type": ["object", "null"] }
          }
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidateSha",
        "runtimeSha",
        "docsSha",
        "gatewayUrlFingerprint",
        "seat",
        "unit",
        "selectedRows",
        "requiredMaxSpawnDepth",
        "expectedMaxSpawnDepth"
      ],
      "properties": {
        "candidateSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "runtimeSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "docsSha": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
        "gatewayUrlFingerprint": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
        "seat": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "selectedRows": { "type": ["array", "null"], "items": { "type": "string" } },
        "requiredMaxSpawnDepth": { "type": ["integer", "null"], "minimum": 1 },
        "expectedMaxSpawnDepth": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "candidate": { "type": "object" },
    "seat": { "type": "object" },
    "session": { "type": "object" },
    "env": { "type": "array" },
    "concurrency": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "bindingDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "signature"],
      "properties": {
        "algorithm": { "const": "hmac-sha256-gateway-token-v1" },
        "signature": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
